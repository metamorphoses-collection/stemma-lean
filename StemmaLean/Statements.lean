/-- `Stemma.CodingLimit.mU`, as defined in the library. -/
theorem «Report.defs».CodingLimit.mU_def (ρ a b α ε : ℝ) (σ : Finset (Fin 4)) :
  mU ρ a b α ε σ =
    if σ = s12 then sU U12 ρ a b α ε
    else if σ = s13 then sU U13 ρ a b α ε else if σ = s14 then sU U14 ρ a b α ε else 0 := rfl

