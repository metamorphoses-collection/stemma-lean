    Stemma.Splits Stemma.Rooted Stemma.Margin in
/-- Proposition 6.10 (Rooted analogue): `Stemma.RootedConsistency.consistency_rooted`. -/
theorem «Report.6.10».consistency_rooted {n : ℕ} {Ω : Type u_1} [MeasurableSpace Ω]
  {μ : Measure Ω} [IsProbabilityMeasure μ] (T : Finset (Finset (Fin n))) (hT : IsBinR T)
  (m : Finset (Fin n) → ℝ) (γ : ℝ) (hγ : 0 < γ)
  (hgap :
    ∀ (S : Finset (Finset (Fin n))),
      IsHier S → S ≠ T → γ * ↑(#(T \ S)) ≤ ∑ σ ∈ T \ S, m σ - ∑ σ ∈ S \ T, m σ)
  {L : ℕ} (hL : 0 < L) (Y : Finset (Fin n) → Fin L → Ω → ℝ)
  (hmeas : ∀ (σ : Finset (Fin n)) (u : Fin L), Measurable (Y σ u))
  (hb : ∀ (σ : Finset (Fin n)) (u : Fin L) (ω : Ω), Y σ u ω ∈ Set.Icc 0 1)
  (hind : ∀ (σ : Finset (Fin n)), iIndepFun (Y σ) μ)
  (hmean : ∀ (σ : Finset (Fin n)) (u : Fin L), ∫ (x : Ω), Y σ u x ∂μ = m σ)
  (R : Finset (Finset (Fin n))) (hR : ∀ σ ∉ R, ∀ (u : Fin L) (ω : Ω), Y σ u ω = 0)
  (hmR : ∀ σ ∉ R, m σ = 0) :
  μ.real
      {ω | ∃ S, IsHier S ∧ S ≠ T ∧ ∑ σ ∈ T, (∑ u, Y σ u ω) / ↑L ≤ ∑ σ ∈ S, (∑ u, Y σ u ω) / ↑L} ≤
    2 * ↑(#R) * rexp (-↑L * γ ^ 2 / 2) :=
  @Stemma.RootedConsistency.consistency_rooted n Ω _ μ _ T hT m γ hγ hgap L hL Y hmeas hb hind hmean R hR hmR

/-! ## Theorem 7.1: Pairwise bound (`thm:pairwise`) -/

open Stemma Stemma.Chernoff MeasureTheory ProbabilityTheory Real Finset Filter
    Topology in
/-- Theorem 7.1 (Pairwise bound): `Stemma.Chernoff.pairwise_bound`. -/
theorem «Report.7.1».pairwise_bound {Ω : Type u_1} [MeasurableSpace Ω] {μ : Measure Ω}
  [IsProbabilityMeasure μ] {n : ℕ} (r : Fin n) (T : Finset (Finset (Fin n)))
  (hT : Splits.IsBinary r T) {L : ℕ} (Y : Finset (Fin n) → Fin L → Ω → ℝ)
  (hmeas : ∀ (σ : Finset (Fin n)) (u : Fin L), Measurable (Y σ u))
  (h01 : ∀ (σ : Finset (Fin n)) (u : Fin L) (ω : Ω), Y σ u ω = 0 ∨ Y σ u ω = 1)
  (hexcl : ∀ (σ τ : Finset (Fin n)) (u : Fin L) (ω : Ω), ¬Compat σ τ → Y σ u ω * Y τ u ω = 0)
  (hind : iIndepFun (fun u ω σ ↦ Y σ u ω) μ) (m : Finset (Fin n) → ℝ)
  (hmnn : ∀ (σ : Finset (Fin n)), 0 ≤ m σ)
  (hmean : ∀ (σ : Finset (Fin n)) (u : Fin L), ∫ (x : Ω), Y σ u x ∂μ = m σ)
  (hzero : ∀ (σ : Finset (Fin n)), m σ = 0 → ∀ (u : Fin L) (ω : Ω), Y σ u ω = 0)
  (hsep :
    ∀ (τ σ : Finset (Fin n)),
      Splits.IsSide r τ → τ ∉ T → 0 < m τ → σ ∈ T → ¬Compat τ σ → m τ < m σ) :
  μ.real {ω | ¬Splits.IsUniqueSolution r (fun σ ↦ ∑ u, Y σ u ω) T} ≤
    ∑ p ∈ conflictPairs r T m, (1 - (√(m p.2) - √(m p.1)) ^ 2) ^ L + ∑ σ ∈ T, (1 - m σ) ^ L :=
  @Stemma.Chernoff.pairwise_bound Ω _ μ _ n r T hT L Y hmeas h01 hexcl hind m hmnn hmean hzero hsep

