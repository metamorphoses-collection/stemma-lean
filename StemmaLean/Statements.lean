/-! ## Lemma 6.1: Displacement matching (`lem:hall`) -/

open Stemma Stemma.Splits Finset in
/-- Lemma 6.1 (Displacement matching): `Stemma.Splits.displacement_matching`. -/
theorem «Report.6.1».displacement_matching {n : ℕ} {r : Fin n} {T S : Finset (Finset (Fin n))}
  (hT : IsBinary r T) (hS : IsSystem r S) (hne : S ≠ T) :
  (T \ S).Nonempty ∧
    #(S \ T) ≤ #(T \ S) ∧
      ∃ φ, Function.Injective φ ∧ ∀ (τ : ↥(S \ T)), φ τ ∈ T \ S ∧ ¬Compat (↑τ) (φ τ) :=
  @Stemma.Splits.displacement_matching n r T S hT hS hne

