  (φ : Fin n → W) (A : Finset (Fin n)) (e : Sym2 W) :
  InSpan T φ A e = ∃ a ∈ A, ∃ a' ∈ A, ∃ (p : T.Walk (φ a) (φ a')), p.IsPath ∧ e ∈ p.edges := rfl

