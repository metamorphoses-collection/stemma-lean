  Laminar K = ∀ e ∈ K, ∀ f ∈ K, e ≠ f → Disjoint e f ∨ f ⊂ e ∨ e ⊂ f := rfl

open Stemma Stemma.CodingLimit MeasureTheory ProbabilityTheory Finset Filter
