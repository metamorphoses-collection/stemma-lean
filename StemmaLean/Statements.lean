open Stemma Stemma.Attraction Finset Stemma.Mechanisms in
open scoped Classical in
/-- `Stemma.Attraction.ex`, as defined in the library. -/
theorem «Report.defs».Attraction.ex_def {n : ℕ} (K : Finset (Finset (Fin n)))
  (π : Finset (Fin n) → ℝ) (α : ℝ)
  (P : Finset (Finset (Fin n)) → (Finset (Fin n) → Bool) → Prop) :
  ex K π α P = ∑ M ∈ K.powerset, ∑ A ∈ M.powerset, wt K π α M A * if P M (attOf A) then 1 else 0 :=
  rfl

open Stemma Stemma.Attraction Finset Stemma.Mechanisms in
