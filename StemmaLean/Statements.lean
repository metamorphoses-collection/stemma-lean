/-! ## Corollary 8.11: A sufficient condition (`cor:modelglobal`) -/

open Stemma Stemma.Irreversible Finset MeasureTheory ProbabilityTheory
    Stemma.Splits Stemma.Attraction in
/-- Corollary 8.11 (A sufficient condition): `Stemma.Irreversible.model_global`. -/
theorem «Report.8.11».model_global {n : ℕ} {K : Finset (Finset (Fin n))} {π : Finset (Fin n) → ℝ}
  (hπ0 : ∀ (e : Finset (Fin n)), 0 ≤ π e) (hπ1 : ∀ (e : Finset (Fin n)), π e ≤ 1)
  (hK : Attraction.Laminar K) (r : Fin n) (T : Finset (Finset (Fin n))) (hT : IsBinary r T)
  (hKT : ∀ e ∈ K, Nontriv e → away r e ∈ T) (hTK : ∀ σ ∈ T, ∃ e ∈ K, e = σ ∨ e = σᶜ) (c : ℝ)
  (hc : ∀ e ∈ K, Nontriv e → c ≤ π e * ∏ f ∈ K, (1 - π f)) (hD : D K π < c) :
  (∀ σ ∈ T, ∀ (τ : Finset (Fin n)), IsSide r τ → τ ∉ T → suppI K π τ < suppI K π σ) ∧
    IsUniqueSolution r (suppI K π) T ∧
      0 < c - D K π ∧
        ∀ (S : Finset (Finset (Fin n))),
          IsSystem r S →
            S ≠ T →
              (c - D K π) * ↑(#(T \ S)) ≤ ∑ σ ∈ T \ S, suppI K π σ - ∑ σ ∈ S \ T, suppI K π σ :=
  @Stemma.Irreversible.model_global n K π hπ0 hπ1 hK r T hT hKT hTK c hc hD

open Stemma Stemma.Irreversible Finset MeasureTheory ProbabilityTheory
    Stemma.Splits Stemma.Attraction in
/-- Corollary 8.11 (A sufficient condition): `Stemma.Irreversible.model_consistency`. -/
theorem «Report.8.11».model_consistency {n : ℕ} {K : Finset (Finset (Fin n))}
  {π : Finset (Fin n) → ℝ} (hπ0 : ∀ (e : Finset (Fin n)), 0 ≤ π e)
  (hπ1 : ∀ (e : Finset (Fin n)), π e ≤ 1) {Ω : Type u_1} [MeasurableSpace Ω] {μ : Measure Ω}
  [IsProbabilityMeasure μ] (hK : Attraction.Laminar K) (r : Fin n) (T : Finset (Finset (Fin n)))
  (hT : IsBinary r T) (hKT : ∀ e ∈ K, Nontriv e → away r e ∈ T)
  (hTK : ∀ σ ∈ T, ∃ e ∈ K, e = σ ∨ e = σᶜ) (c : ℝ)
  (hc : ∀ e ∈ K, Nontriv e → c ≤ π e * ∏ f ∈ K, (1 - π f)) (hD : D K π < c) {L : ℕ} (hL : 0 < L)
  (Y : Finset (Fin n) → Fin L → Ω → ℝ)
  (hmeas : ∀ (σ : Finset (Fin n)) (u : Fin L), Measurable (Y σ u))
  (hb : ∀ (σ : Finset (Fin n)) (u : Fin L) (ω : Ω), Y σ u ω ∈ Set.Icc 0 1)
  (hind : ∀ (σ : Finset (Fin n)), iIndepFun (Y σ) μ)
  (hmean : ∀ (σ : Finset (Fin n)) (u : Fin L), ∫ (x : Ω), Y σ u x ∂μ = suppI K π σ)
  (R : Finset (Finset (Fin n))) (hR : ∀ σ ∉ R, ∀ (u : Fin L) (ω : Ω), Y σ u ω = 0)
  (hmR : ∀ σ ∉ R, suppI K π σ = 0) :
  μ.real
      {ω |
        ∃ S,
          IsSystem r S ∧ S ≠ T ∧ ∑ σ ∈ T, (∑ u, Y σ u ω) / ↑L ≤ ∑ σ ∈ S, (∑ u, Y σ u ω) / ↑L} ≤
    2 * ↑(#R) * Real.exp (-↑L * (c - D K π) ^ 2 / 2) :=
  @Stemma.Irreversible.model_consistency n K π hπ0 hπ1 Ω _ μ _ hK r T hT hKT hTK c hc hD L hL Y hmeas hb hind hmean R hR hmR

/-! ## Proposition 8.12: Quartet (`prop:quartet`) -/

open Stemma Stemma.Quartet in
/-- Proposition 8.12 (Quartet): `Stemma.Quartet.m12`. -/
theorem «Report.8.12».m12 (r₁ r₂ p₁ p₂ p₃ p₄ : ℝ) :
  supp r₁ r₂ p₁ p₂ p₃ p₄ P12 =
    (1 - r₂) * (1 - p₃) * (1 - p₄) * (r₁ + (1 - r₁) * p₁ * p₂) +
      (1 - r₁) * (1 - p₁) * (1 - p₂) * (r₂ + (1 - r₂) * p₃ * p₄) :=
  @Stemma.Quartet.m12 r₁ r₂ p₁ p₂ p₃ p₄

open Stemma Stemma.Quartet in
/-- Proposition 8.12 (Quartet): `Stemma.Quartet.m13`. -/
theorem «Report.8.12».m13 (r₁ r₂ p₁ p₂ p₃ p₄ : ℝ) :
  supp r₁ r₂ p₁ p₂ p₃ p₄ P13 =
    (1 - r₁) * (1 - r₂) * (p₁ * p₃ * (1 - p₂) * (1 - p₄) + p₂ * p₄ * (1 - p₁) * (1 - p₃)) :=
  @Stemma.Quartet.m13 r₁ r₂ p₁ p₂ p₃ p₄

open Stemma Stemma.Quartet in
/-- Proposition 8.12 (Quartet): `Stemma.Quartet.m14`. -/
theorem «Report.8.12».m14 (r₁ r₂ p₁ p₂ p₃ p₄ : ℝ) :
  supp r₁ r₂ p₁ p₂ p₃ p₄ P14 =
    (1 - r₁) * (1 - r₂) * (p₁ * p₄ * (1 - p₂) * (1 - p₃) + p₂ * p₃ * (1 - p₁) * (1 - p₄)) :=
  @Stemma.Quartet.m14 r₁ r₂ p₁ p₂ p₃ p₄

/-! ## Corollary 8.13: Textual long-branch zone (`cor:lba`) -/

open Stemma Stemma.Quartet in
/-- Corollary 8.13 (Textual long-branch zone): `Stemma.Quartet.long_branch`. -/
theorem «Report.8.13».long_branch (r p₁ p₃ : ℝ) (hr : r < 1) (hp₁ : 0 ≤ p₁) (hp₃ : 0 ≤ p₃) :
  max (supp r r p₁ 0 p₃ 0 P13) (supp r r p₁ 0 p₃ 0 P14) < supp r r p₁ 0 p₃ 0 P12 ↔
    (1 - r) * p₁ * p₃ < r * (2 - p₁ - p₃) := @Stemma.Quartet.long_branch r p₁ p₃ hr hp₁ hp₃

open Stemma Stemma.CodingLimit MeasureTheory ProbabilityTheory Finset Filter
    Topology Real Stemma.Splits Stemma.Quartet Stemma.Coding in
/-- Corollary 8.13 (Textual long-branch zone): `Stemma.CodingLimit.long_branch_consistent`. -/
theorem «Report.8.13».long_branch_consistent (r p₁ p₃ : ℝ) (hr : r < 1) (hp₁ : 0 ≤ p₁)
  (hp₃ : 0 ≤ p₃) (h : (1 - r) * p₁ * p₃ < r * (2 - p₁ - p₃)) :
  ∃ γ > 0,
    ∀ (Ω : Type) [inst : MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ] (L : ℕ),
      0 < L →
        ∀ (Y : Finset (Fin 4) → Fin L → Ω → ℝ),
          (∀ (σ : Finset (Fin 4)) (u : Fin L), Measurable (Y σ u)) →
            (∀ (σ : Finset (Fin 4)) (u : Fin L) (ω : Ω), Y σ u ω ∈ Set.Icc 0 1) →
              (∀ (σ : Finset (Fin 4)), iIndepFun (Y σ) μ) →
                (∀ (σ : Finset (Fin 4)) (u : Fin L), ∫ (x : Ω), Y σ u x ∂μ = mQ r p₁ p₃ σ) →
                  (∀ (σ : Finset (Fin 4)),
                      σ ≠ s12 → σ ≠ s13 → σ ≠ s14 → ∀ (u : Fin L) (ω : Ω), Y σ u ω = 0) →
                    μ.real
                        {ω |
                          ∃ S,
                            IsSystem 3 S ∧
                              S ≠ {s12} ∧
                                ∑ σ ∈ {s12}, (∑ u, Y σ u ω) / ↑L ≤
                                  ∑ σ ∈ S, (∑ u, Y σ u ω) / ↑L} ≤
                      2 * 3 * rexp (-↑L * γ ^ 2 / 2) :=
  @Stemma.CodingLimit.long_branch_consistent r p₁ p₃ hr hp₁ hp₃ h

open Stemma Stemma.CodingLimit MeasureTheory ProbabilityTheory Finset Filter
    Topology Real Stemma.Splits Stemma.Quartet Stemma.Coding in
/-- Corollary 8.13 (Textual long-branch zone): `Stemma.CodingLimit.long_branch_inconsistent`. -/
theorem «Report.8.13».long_branch_inconsistent (r p₁ p₃ : ℝ) (hr0 : 0 ≤ r) (hr : r < 1)
  (hp₁ : 0 ≤ p₁) (hp₁' : p₁ ≤ 1) (hp₃ : 0 ≤ p₃) (hp₃' : p₃ ≤ 1)
  (h : r * (2 - p₁ - p₃) < (1 - r) * p₁ * p₃) (Ω : Type) [MeasurableSpace Ω] (μ : Measure Ω)
  [IsProbabilityMeasure μ] (Y : Finset (Fin 4) → ℕ → Ω → ℝ) :
  (∀ (σ : Finset (Fin 4)) (u : ℕ), Measurable (Y σ u)) →
    (∀ (σ : Finset (Fin 4)) (u : ℕ) (ω : Ω), Y σ u ω ∈ Set.Icc 0 1) →
      (Pairwise fun i j ↦ (fun ω σ ↦ Y σ i ω) ⟂ᵢ[μ] fun ω σ ↦ Y σ j ω) →
        (∀ (u : ℕ), IdentDistrib (fun ω σ ↦ Y σ u ω) (fun ω σ ↦ Y σ 0 ω) μ μ) →
          (∀ (σ : Finset (Fin 4)), ∫ (x : Ω), Y σ 0 x ∂μ = mQ r p₁ p₃ σ) →
            (∀ᵐ (ω : Ω) ∂μ,
                ∀ᶠ (L : ℕ) in atTop,
                  ∀ (S : Finset (Finset (Fin 4))),
                    IsSystem 3 S →
                      S ≠ {s13} →
                        ∑ σ ∈ S, ∑ u ∈ range L, Y σ u ω < ∑ σ ∈ {s13}, ∑ u ∈ range L, Y σ u ω) ∧
              Tendsto
                (fun L ↦
                  μ
                    {ω |
                        ∀ (S : Finset (Finset (Fin 4))),
                          IsSystem 3 S →
                            S ≠ {s13} →
                              ∑ σ ∈ S, ∑ u ∈ range L, Y σ u ω <
                                ∑ σ ∈ {s13}, ∑ u ∈ range L, Y σ u ω}ᶜ)
                atTop (𝓝 0) :=
  @Stemma.CodingLimit.long_branch_inconsistent r p₁ p₃ hr0 hr hp₁ hp₁' hp₃ hp₃' h Ω _ μ _ Y

/-! ## Theorem 8.14: At leading order, coincidence enters only the rooted coding (`thm:coding`) -/

open Stemma Stemma.CodingLimit MeasureTheory ProbabilityTheory Finset Filter
