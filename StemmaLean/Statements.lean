/-- Theorem 7.4 (Consistency): `Stemma.Margin.inconsistency`. -/
theorem «Report.7.4».inconsistency {n : ℕ} {Ω : Type u_1} [MeasurableSpace Ω] {μ : Measure Ω}
  [IsProbabilityMeasure μ] (r : Fin n) (T S : Finset (Finset (Fin n))) (hS : IsSystem r S)
  (Y : Finset (Fin n) → ℕ → Ω → ℝ) (hmeas : ∀ (σ : Finset (Fin n)) (u : ℕ), Measurable (Y σ u))
  (hb : ∀ (σ : Finset (Fin n)) (u : ℕ) (ω : Ω), Y σ u ω ∈ Set.Icc 0 1)
  (hindep : Pairwise fun i j ↦ (fun ω σ ↦ Y σ i ω) ⟂ᵢ[μ] fun ω σ ↦ Y σ j ω)
  (hident : ∀ (u : ℕ), IdentDistrib (fun ω σ ↦ Y σ u ω) (fun ω σ ↦ Y σ 0 ω) μ μ)
  (m : Finset (Fin n) → ℝ) (hmean : ∀ (σ : Finset (Fin n)), ∫ (x : Ω), Y σ 0 x ∂μ = m σ)
  (hlt : ∑ σ ∈ T, m σ < ∑ σ ∈ S, m σ) :
  (∀ᵐ (ω : Ω) ∂μ,
      ∀ᶠ (L : ℕ) in atTop, ∑ σ ∈ T, ∑ u ∈ range L, Y σ u ω < ∑ σ ∈ S, ∑ u ∈ range L, Y σ u ω) ∧
    Tendsto
      (fun L ↦
        μ
          {ω |
            ∀ (S' : Finset (Finset (Fin n))),
              IsSystem r S' →
                ∑ σ ∈ S', ∑ u ∈ range L, Y σ u ω ≤ ∑ σ ∈ T, ∑ u ∈ range L, Y σ u ω})
      atTop (𝓝 0) :=
  @Stemma.Margin.inconsistency n Ω _ μ _ r T S hS Y hmeas hb hindep hident m hmean hlt

