/-! ## Theorem 4.1: Universality (`thm:universal`) -/

open Stemma Stemma.Universal Finset in
/-- Theorem 4.1 (Universality): `Stemma.Universal.universality`. -/
theorem «Report.4.1».universality {V : Type u_1} [Fintype V] [DecidableEq V] (H : SimpleGraph V)
  [DecidableRel H.Adj] :
  ∃ (σ : V → Finset (Fin (4 * #H.edgeFinset + 2 * Fintype.card V + 2))),
    (∀ (v : V), 2 ≤ #(σ v) ∧ 2 ≤ #(σ v)ᶜ) ∧
      (∀ (u v : V), u ≠ v → σ u ≠ σ v ∧ σ u ≠ (σ v)ᶜ) ∧
        ∀ (u v : V), u ≠ v → (¬Compat (σ u) (σ v) ↔ H.Adj u v) :=
  @Stemma.Universal.universality V _ _ H _

