/-- Proposition 7.15 (A tolerance independent of the number of witnesses): `Stemma.CuttingDimFree.four_parts`. -/
theorem «Report.7.15».four_parts {n : ℕ} {r : Fin n} {T' : Finset (Finset (Fin n))}
  (hT' : IsBinary r T') {A : Finset (Fin n)} (hA : A ∈ sides r) (hAT : A ∉ T') :
  ∃ A₁ A₂ B₁ B₂,
    A₁.Nonempty ∧
      A₂.Nonempty ∧
        B₁.Nonempty ∧
          B₂.Nonempty ∧
            Disjoint A₁ A₂ ∧
              A₁ ∪ A₂ = A ∧
                Disjoint B₁ B₂ ∧
                  B₁ ∪ B₂ = Aᶜ ∧
                    ∀ (O : Finset (Fin n)),
                      (∃ τ ∈ T', SameRestr O τ A) →
                        Disjoint A₁ O ∨ Disjoint A₂ O ∨ Disjoint B₁ O ∨ Disjoint B₂ O :=
  @Stemma.CuttingDimFree.four_parts n r T' hT' A hA hAT

