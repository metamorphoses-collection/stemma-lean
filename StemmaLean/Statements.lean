/-! ## Proposition 7.8: Dependent blocks (`prop:blocks`) -/

open Stemma Stemma.Blocks MeasureTheory ProbabilityTheory Real in
/-- Proposition 7.8 (Dependent blocks): `Stemma.Blocks.dependent_blocks`. -/
theorem «Report.7.8».dependent_blocks {Ω : Type u_1} [MeasurableSpace Ω] {μ : Measure Ω}
  [IsProbabilityMeasure μ] {n : ℕ} (r : Fin n) (T : Finset (Finset (Fin n)))
  (hT : Splits.IsBinary r T) (m : Finset (Fin n) → ℝ) (γ : ℝ) (hγ : 0 < γ)
  (hgap :
    ∀ (S : Finset (Finset (Fin n))),
      Splits.IsSystem r S → S ≠ T → γ * ↑(T \ S).card ≤ ∑ σ ∈ T \ S, m σ - ∑ σ ∈ S \ T, m σ)
  {J k : ℕ} (hJ : 0 < J) (hk : 0 < k) (Y : Finset (Fin n) → Fin J → Fin k → Ω → ℝ)
  (hmeas : ∀ (σ : Finset (Fin n)) (j : Fin J) (i : Fin k), Measurable (Y σ j i))
  (hb : ∀ (σ : Finset (Fin n)) (j : Fin J) (i : Fin k) (ω : Ω), Y σ j i ω ∈ Set.Icc 0 1)
  (hind : ∀ (σ : Finset (Fin n)), iIndepFun (fun j ω i ↦ Y σ j i ω) μ)
  (hmean :
    ∀ (σ : Finset (Fin n)) (j : Fin J), ∫ (x : Ω), (fun ω ↦ ∑ i, Y σ j i ω) x ∂μ = ↑k * m σ)
  (R : Finset (Finset (Fin n))) (hR : ∀ σ ∉ R, ∀ (j : Fin J) (i : Fin k) (ω : Ω), Y σ j i ω = 0)
  (hmR : ∀ σ ∉ R, m σ = 0) :
  μ.real
      {ω |
        ∃ S,
          Splits.IsSystem r S ∧
            S ≠ T ∧ ∑ σ ∈ T, ∑ j, ∑ i, Y σ j i ω ≤ ∑ σ ∈ S, ∑ j, ∑ i, Y σ j i ω} ≤
    2 * ↑R.card * rexp (-↑J * γ ^ 2 / 2) :=
  @Stemma.Blocks.dependent_blocks Ω _ μ _ n r T hT m γ hγ hgap J k hJ hk Y hmeas hb hind hmean R hR hmR

/-! ## Theorem 7.9: Confidence bound for the margin (`thm:gammaconf`) -/

open Stemma Stemma.GammaConf MeasureTheory Finset Stemma.Splits Stemma.Margin in
/-- Theorem 7.9 (Confidence bound for the margin): `Stemma.GammaConf.gamma_confidence`. -/
theorem «Report.7.9».gamma_confidence {n : ℕ} {Ω : Type u_1} [MeasurableSpace Ω] {μ : Measure Ω}
  [IsProbabilityMeasure μ] (r : Fin n) (m : Finset (Fin n) → ℝ) (ℓ u : Finset (Fin n) → Ω → ℝ)
  {δ : ℝ} (hδ : 0 ≤ δ) (hlo : ∀ s ∈ sides r, μ.real {ω | m s < ℓ s ω} ≤ δ / (2 * ↑(#(sides r))))
  (hup : ∀ s ∈ sides r, μ.real {ω | u s ω < m s} ≤ δ / (2 * ↑(#(sides r)))) :
  μ.real
        {ω |
          ¬∀ (T : Finset (Finset (Fin n))),
              IsBinary r T →
                ∀ (hTne : T.Nonempty),
                  loMargin r (fun s ↦ ℓ s ω) (fun s ↦ u s ω) T hTne ≤ margin r m T hTne} ≤
      δ ∧
    μ.real
        {ω |
          ∃ T,
            ∃ (_ : IsBinary r T) (hTne : T.Nonempty),
              0 < loMargin r (fun s ↦ ℓ s ω) (fun s ↦ u s ω) T hTne ∧
                ¬∀ (S : Finset (Finset (Fin n))), IsSystem r S → S ≠ T → wt m S < wt m T} ≤
      δ := @Stemma.GammaConf.gamma_confidence n Ω _ μ _ r m ℓ u δ hδ hlo hup

/-! ## Proposition 7.11: Certifying the margin with dependent units (`prop:gammablocks`) -/

open Stemma Stemma.GammaBlocks MeasureTheory ProbabilityTheory Finset Real
    Stemma.Splits Stemma.Margin Stemma.GammaConf in
/-- Proposition 7.11 (Certifying the margin with dependent units): `Stemma.GammaBlocks.gamma_confidence_blocks`. -/
theorem «Report.7.11».gamma_confidence_blocks {n : ℕ} {Ω : Type u_1} [MeasurableSpace Ω]
  {μ : Measure Ω} [IsProbabilityMeasure μ] (r : Fin n) {J k : ℕ} (hJ : 0 < J) (hk : 0 < k)
  (Y : Finset (Fin n) → Fin J → Fin k → Ω → ℝ)
  (hmeas : ∀ (s : Finset (Fin n)) (j : Fin J) (i : Fin k), Measurable (Y s j i))
  (hb : ∀ (s : Finset (Fin n)) (j : Fin J) (i : Fin k) (ω : Ω), Y s j i ω ∈ Set.Icc 0 1)
  (hind : ∀ (s : Finset (Fin n)), iIndepFun (fun j ω i ↦ Y s j i ω) μ) (m : Finset (Fin n) → ℝ)
  (hmean :
    ∀ (s : Finset (Fin n)) (j : Fin J), ∫ (x : Ω), (fun ω ↦ ∑ i, Y s j i ω) x ∂μ = ↑k * m s)
  {δ : ℝ} (hδ : 0 < δ) :
  μ.real
        {ω |
          ¬∀ (T : Finset (Finset (Fin n))),
              IsBinary r T →
                ∀ (hTne : T.Nonempty),
                  loMargin r (fun s ↦ rate Y s ω - radius (#(sides r)) J δ)
                      (fun s ↦ rate Y s ω + radius (#(sides r)) J δ) T hTne ≤
                    margin r m T hTne} ≤
      δ ∧
    μ.real
        {ω |
          ∃ T,
            ∃ (_ : IsBinary r T) (hTne : T.Nonempty),
              0 <
                  loMargin r (fun s ↦ rate Y s ω - radius (#(sides r)) J δ)
                    (fun s ↦ rate Y s ω + radius (#(sides r)) J δ) T hTne ∧
                ¬∀ (S : Finset (Finset (Fin n))), IsSystem r S → S ≠ T → wt m S < wt m T} ≤
      δ :=
  @Stemma.GammaBlocks.gamma_confidence_blocks n Ω _ μ _ r J k hJ hk Y hmeas hb hind m hmean δ hδ

