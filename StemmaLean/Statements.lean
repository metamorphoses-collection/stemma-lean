open Stemma Stemma.Attraction Finset Stemma.Mechanisms in
open scoped Classical in
/-- `Stemma.Attraction.omega`, as defined in the library. -/
theorem «Report.defs».Attraction.omega_def {n : ℕ}
  (P : Finset (Finset (Fin n)) → (Finset (Fin n) → Bool) → Prop) (α : ℝ)
  (S : Finset (Finset (Fin n))) :
  omega P α S =
    (α ^ 2 * if P S (attOf S) then 1 else 0) + (1 - α ^ 2) * if P S (attOf ∅) then 1 else 0 := rfl

open Stemma Stemma.Splits Finset in
