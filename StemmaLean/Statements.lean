/- `Stemma.PolytomyNull.Vertex`, as defined in the library. -/
#check @Stemma.PolytomyNull.Vertex

open Stemma Stemma.PolytomyNull Finset Stemma.Mechanisms Stemma.Attraction in
/-- `Stemma.PolytomyNull.lead`, as defined in the library. -/
theorem «Report.defs».PolytomyNull.lead_def {n : ℕ} (Cs K : Finset (Finset (Fin n)))
  (ci cj : Finset (Fin n)) (α : ℝ) (f : Finset (Fin n) → ℝ) :
  lead Cs K ci cj α f =
    α ^ 2 * (f ci * f cj) +
      ∑ c ∈ Cs with c ≠ ci ∧ c ≠ cj,
        if #Cs = 3 ∧ Cs.sup id ∈ K then (1 - α ^ 2) * (f (Cs.sup id) * f c) else 0 := rfl

open Stemma Stemma.PolytomyNull Finset Stemma.Mechanisms Stemma.Attraction in
/-- `Stemma.PolytomyNull.q`, as defined in the library. -/
theorem «Report.defs».PolytomyNull.q_def {n : ℕ} (K : Finset (Finset (Fin n)))
  (π : Finset (Fin n) → ℝ) (α : ℝ) (D : Finset (Fin n)) :
  q K π α D = ex K π α fun M att ↦ nonorig M att = D := rfl

