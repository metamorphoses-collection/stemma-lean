open Stemma Stemma.Consistency MeasureTheory ProbabilityTheory Real in
/-- Theorem 7.4 (Consistency): `Stemma.Consistency.consistency`. -/
theorem «Report.7.4».consistency {Ω : Type u_2} [MeasurableSpace Ω] {μ : Measure Ω}
  [IsProbabilityMeasure μ] {n : ℕ} (r : Fin n) (T : Finset (Finset (Fin n)))
  (hT : Splits.IsBinary r T) (m : Finset (Fin n) → ℝ) (γ : ℝ) (hγ : 0 < γ)
  (hgap :
    ∀ (S : Finset (Finset (Fin n))),
      Splits.IsSystem r S → S ≠ T → γ * ↑(T \ S).card ≤ ∑ σ ∈ T \ S, m σ - ∑ σ ∈ S \ T, m σ)
  {L : ℕ} (hL : 0 < L) (Y : Finset (Fin n) → Fin L → Ω → ℝ)
  (hmeas : ∀ (σ : Finset (Fin n)) (u : Fin L), Measurable (Y σ u))
  (hb : ∀ (σ : Finset (Fin n)) (u : Fin L) (ω : Ω), Y σ u ω ∈ Set.Icc 0 1)
  (hind : ∀ (σ : Finset (Fin n)), iIndepFun (Y σ) μ)
  (hmean : ∀ (σ : Finset (Fin n)) (u : Fin L), ∫ (x : Ω), Y σ u x ∂μ = m σ)
  (R : Finset (Finset (Fin n))) (hR : ∀ σ ∉ R, ∀ (u : Fin L) (ω : Ω), Y σ u ω = 0)
  (hmR : ∀ σ ∉ R, m σ = 0) :
  μ.real
      {ω |
        ∃ S,
          Splits.IsSystem r S ∧
            S ≠ T ∧ ∑ σ ∈ T, (∑ u, Y σ u ω) / ↑L ≤ ∑ σ ∈ S, (∑ u, Y σ u ω) / ↑L} ≤
    2 * ↑R.card * rexp (-↑L * γ ^ 2 / 2) :=
  @Stemma.Consistency.consistency Ω _ μ _ n r T hT m γ hγ hgap L hL Y hmeas hb hind hmean R hR hmR

