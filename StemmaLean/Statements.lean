  {V : Finset (Fin n)} (hV : V ∈ S ∨ V = univ) {D₁ D₂ D₃ : Finset (Fin n)} (h₁ : IsChild S V D₁)
  (h₂ : IsChild S V D₂) (h₃ : IsChild S V D₃) (h12 : D₁ ≠ D₂) (h13 : D₁ ≠ D₃) (h23 : D₂ ≠ D₃) :
  w (D₁ ∪ D₂) = 0 :=
  @Stemma.RootedTop.two_branched_top n w hw0 S hS V hV D₁ D₂ D₃ h₁ h₂ h₃ h12 h13 h23

