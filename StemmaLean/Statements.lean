theorem «Report.defs».Attraction.P3_def {n : ℕ} (K : Finset (Finset (Fin n)))
  (π : Finset (Fin n) → ℝ) (α : ℝ) : P3 K π α = ex K π α fun M x ↦ 3 ≤ #M := rfl

