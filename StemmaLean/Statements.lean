theorem «Report.defs».IsOptimal_def {n : ℕ} (w : Finset (Fin n) → ℕ)
  (S : Finset (Finset (Fin n))) :
  IsOptimal w S =
    (PairwiseCompat S ∧
      ∀ (T : Finset (Finset (Fin n))), PairwiseCompat T → weight w T ≤ weight w S) := rfl

open Stemma Stemma.Polytomy MeasureTheory ProbabilityTheory Finset Stemma.Splits in
/-- `Stemma.Polytomy.IsChild`, as defined in the library. -/
theorem «Report.defs».Polytomy.IsChild_def {n : ℕ} (T : Finset (Finset (Fin n)))
  (C D : Finset (Fin n)) :
  IsChild T C D = (D ⊂ C ∧ (D ∈ T ∨ #D = 1) ∧ ∀ E ⊂ C, E ∈ T ∨ #E = 1 → D ⊆ E → E = D) := rfl

open Stemma Stemma.Chernoff MeasureTheory ProbabilityTheory Real Finset Filter
