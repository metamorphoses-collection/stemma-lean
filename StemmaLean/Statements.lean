open Stemma Stemma.Splits Finset in
/-- Proposition 6.9 (Threshold for non-binary stemmata): `Stemma.Splits.threshold`. -/
theorem «Report.6.9».threshold {n : ℕ} {r : Fin n} {T : Finset (Finset (Fin n))}
  (hT : IsSystem r T) (hTne : T.Nonempty) (w : Finset (Fin n) → ℝ)
  (hw0 : ∀ (A : Finset (Fin n)), IsSide r A → 0 ≤ w A) (t : ℝ)
  (hfalse : ∀ (τ : Finset (Fin n)), IsSide r τ → τ ∉ T → w τ ≤ t) (htrue : ∀ σ ∈ T, t < w σ) :
  (∀ (A : Finset (Fin n)), IsSide r A → (t < w A ↔ A ∈ T)) ∧
    (∀ σ ∈ T, 0 < w σ) ∧
      ∀ (S : Finset (Finset (Fin n))),
        IsSystem r S → (∀ τ ∈ S, t < w τ) → S ≠ T → wt w S < wt w T :=
  @Stemma.Splits.threshold n r T hT hTne w hw0 t hfalse htrue

