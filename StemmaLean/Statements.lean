/-! ## Proposition 8.19: Coincidence null at a polytomy (`prop:polytomynull`) -/

open Stemma Stemma.PolytomyNull Finset Stemma.Mechanisms Stemma.Attraction in
/-- Proposition 8.19 (Coincidence null at a polytomy): `Stemma.PolytomyNull.null_bound`. -/
theorem «Report.8.19».null_bound {n : ℕ} {K Cs : Finset (Finset (Fin n))} (hV : Vertex K Cs)
  (hKne : ∀ e ∈ K, e.Nonempty) (hK : Laminar K) {ci cj : Finset (Fin n)} (hi : ci ∈ Cs)
  (hj : cj ∈ Cs) (hij : ci ≠ cj) {π : Finset (Fin n) → ℝ} {α : ℝ}
  (hπ0 : ∀ (e : Finset (Fin n)), 0 ≤ π e) (hπ1 : ∀ (e : Finset (Fin n)), π e ≤ 1) (hα0 : 0 ≤ α)
  (hα1 : α ≤ 1) (hs1 : ∑ g ∈ K, π g ≤ 1) :
  |ex K π α (PR (ci ∪ cj)) - lead Cs K ci cj α (q K π α)| ≤ 7 * (∑ g ∈ K, π g) ^ 3 :=
  @Stemma.PolytomyNull.null_bound n K Cs hV hKne hK ci cj hi hj hij π α hπ0 hπ1 hα0 hα1 hs1

open Stemma Stemma.PolytomyMix MeasureTheory Finset Stemma.Mechanisms
    Stemma.Attraction Stemma.PolytomyNull in
/-- Proposition 8.19 (Coincidence null at a polytomy): `Stemma.PolytomyMix.null_mixture`. -/
theorem «Report.8.19».null_mixture {n : ℕ} {K Cs : Finset (Finset (Fin n))} (hV : Vertex K Cs)
  (hKne : ∀ e ∈ K, e.Nonempty) (hK : Laminar K) {ci cj : Finset (Fin n)} (hi : ci ∈ Cs)
  (hj : cj ∈ Cs) (hij : ci ≠ cj) {π : Finset (Fin n) → ℝ} {α : ℝ}
  (hπ0 : ∀ (e : Finset (Fin n)), 0 ≤ π e) (hα0 : 0 ≤ α) (hα1 : α ≤ 1) {ν : Measure ℝ}
  [IsProbabilityMeasure ν] {ρm : ℝ} (hsupp : ∀ᵐ (ρ : ℝ) ∂ν, 0 ≤ ρ ∧ ρ ≤ ρm)
  (hρs : ρm * ∑ g ∈ K, π g ≤ 1) (hE1 : 0 < ∫ (ρ : ℝ), ρ ∂ν) :
  |∫ (ρ : ℝ), ex K (sc ρ π) α (PR (ci ∪ cj)) ∂ν -
        (∫ (ρ : ℝ), ρ ^ 2 ∂ν) / (∫ (ρ : ℝ), ρ ∂ν) ^ 2 *
          lead Cs K ci cj α fun D ↦ ∫ (ρ : ℝ), q K (sc ρ π) α D ∂ν| ≤
    (7 * ∫ (ρ : ℝ), ρ ^ 3 ∂ν) * (∑ g ∈ K, π g) ^ 3 :=
  @Stemma.PolytomyMix.null_mixture n K Cs hV hKne hK ci cj hi hj hij π α hπ0 hα0 hα1 ν _ ρm hsupp hρs hE1

