/-! ## Corollary 7.6: Sample size (`cor:samplesize`) -/

open Stemma Stemma.Margin MeasureTheory ProbabilityTheory Real Finset Filter
    Topology Stemma.Splits in
/-- Corollary 7.6 (Sample size): `Stemma.Margin.sample_size`. -/
theorem «Report.7.6».sample_size {n : ℕ} {Ω : Type u_1} [MeasurableSpace Ω] {μ : Measure Ω}
  [IsProbabilityMeasure μ] (r : Fin n) (T : Finset (Finset (Fin n))) (hT : IsBinary r T)
  (m : Finset (Fin n) → ℝ) (γ : ℝ) (hγ : 0 < γ)
  (hgap :
    ∀ (S : Finset (Finset (Fin n))),
      IsSystem r S → S ≠ T → γ * ↑(#(T \ S)) ≤ ∑ σ ∈ T \ S, m σ - ∑ σ ∈ S \ T, m σ)
  {L : ℕ} (hL : 0 < L) (Y : Finset (Fin n) → Fin L → Ω → ℝ)
  (hmeas : ∀ (σ : Finset (Fin n)) (u : Fin L), Measurable (Y σ u))
  (hb : ∀ (σ : Finset (Fin n)) (u : Fin L) (ω : Ω), Y σ u ω ∈ Set.Icc 0 1)
  (hind : ∀ (σ : Finset (Fin n)), iIndepFun (Y σ) μ)
  (hmean : ∀ (σ : Finset (Fin n)) (u : Fin L), ∫ (x : Ω), Y σ u x ∂μ = m σ)
  (R : Finset (Finset (Fin n))) (hR : ∀ σ ∉ R, ∀ (u : Fin L) (ω : Ω), Y σ u ω = 0)
  (hmR : ∀ σ ∉ R, m σ = 0) {ε mmax : ℝ} (hε : 0 < ε) (hε1 : ε < 1) (hmax : ∀ σ ∈ R, m σ ≤ mmax)
  (hLbig : (8 * mmax + 4 * γ / 3) / γ ^ 2 * log (2 * ↑(#R) / ε) ≤ ↑L) :
  μ.real
      {ω |
        ∃ S,
          IsSystem r S ∧ S ≠ T ∧ ∑ σ ∈ T, (∑ u, Y σ u ω) / ↑L ≤ ∑ σ ∈ S, (∑ u, Y σ u ω) / ↑L} ≤
    ε :=
