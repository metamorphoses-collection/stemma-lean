theorem «Report.defs».CuttingPlanes.weight_def {n : ℕ} (c : PSplit n → ℝ)
  (F : Finset (PSplit n)) : weight c F = ∑ s ∈ F, c s := rfl

open Stemma Stemma.Splits Finset in
/-- `Stemma.Splits.IsBinary`, as defined in the library. -/
theorem «Report.defs».Splits.IsBinary_def {n : ℕ} (r : Fin n) (T : Finset (Finset (Fin n))) :
  IsBinary r T = (IsSystem r T ∧ #T = n - 3) := rfl

open Stemma Stemma.Splits Finset in
/-- `Stemma.Splits.IsUniqueSolution`, as defined in the library. -/
theorem «Report.defs».Splits.IsUniqueSolution_def {n : ℕ} (r : Fin n) (w : Finset (Fin n) → ℝ)
  (T : Finset (Finset (Fin n))) :
  IsUniqueSolution r w T =
    (IsSystem r T ∧
      (∀ σ ∈ T, 0 < w σ) ∧
        ∀ (S : Finset (Finset (Fin n))),
          IsSystem r S → (∀ τ ∈ S, 0 < w τ) → S ≠ T → wt w S < wt w T) := rfl

open Stemma Stemma.Splits Finset in
