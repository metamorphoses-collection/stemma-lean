open Stemma in
/-- `Stemma.Compat`, as defined in the library. -/
theorem «Report.defs».Compat_def {n : ℕ} (A C : Finset (Fin n)) :
  Compat A C = (A ∩ C = ∅ ∨ A ∩ Cᶜ = ∅ ∨ Aᶜ ∩ C = ∅ ∨ Aᶜ ∩ Cᶜ = ∅) := rfl

open Stemma Stemma.CuttingPlanes Finset Stemma.Cutting in
/-- `Stemma.CuttingPlanes.ValidCuts`, as defined in the library. -/
theorem «Report.defs».CuttingPlanes.ValidCuts_def {n : ℕ} (cuts : Finset (Finset (PSplit n))) :
  ValidCuts cuts = ∀ K ∈ cuts, ¬JointlyCompletable K := rfl

open Stemma Stemma.CuttingPlanes Finset Stemma.Cutting in
/-- `Stemma.CuttingPlanes.IsMasterOpt`, as defined in the library. -/
theorem «Report.defs».CuttingPlanes.IsMasterOpt_def {n : ℕ} (C : Finset (PSplit n))
  (c : PSplit n → ℝ) (cuts : Finset (Finset (PSplit n))) (S : Finset (PSplit n)) :
  IsMasterOpt C c cuts S =
    (Feasible C cuts S ∧ ∀ (F : Finset (PSplit n)), Feasible C cuts F → weight c F ≤ weight c S) :=
  rfl

open Stemma Stemma.Cutting MeasureTheory ProbabilityTheory Finset Filter Topology
    Stemma.Splits in
/-- `Stemma.Cutting.JointlyCompletable`, as defined in the library. -/
theorem «Report.defs».Cutting.JointlyCompletable_def {n : ℕ} (P : Finset (PSplit n)) :
  JointlyCompletable P =
    ∃ (ext : PSplit n → Finset (Fin n)),
      (∀ s ∈ P, Extends s (ext s)) ∧ ∀ s ∈ P, ∀ t ∈ P, Compat (ext s) (ext t) := rfl

open Stemma Stemma.CuttingPlanes Finset Stemma.Cutting in
