theorem «Report.defs».Crossing.side_def {n : ℕ} {W : Type u_1} (T : SimpleGraph W)
  (φ : Fin n → W) (e : Sym2 W) (w : W) :
  side T φ e w = Finset.filter (fun y ↦ (T.deleteEdges {e}).Reachable w (φ y)) univ := rfl

open Stemma Stemma.Crossing Finset Phylogenetics.SplitsEquivalence SimpleGraph
