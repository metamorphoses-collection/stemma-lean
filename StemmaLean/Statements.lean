/-! ## Theorem 8.3: Bédier threshold (`thm:bedier`) -/

open Stemma Stemma.Chernoff MeasureTheory ProbabilityTheory Real Finset Filter
    Topology in
/-- Theorem 8.3 (Bédier threshold): `Stemma.Chernoff.bedier_threshold`. -/
theorem «Report.8.3».bedier_threshold {Ω : Type u_1} [MeasurableSpace Ω] {μ : Measure Ω}
  [IsProbabilityMeasure μ] {n : ℕ} (r : Fin n) (T : Finset (Finset (Fin n)))
  (hT : Splits.IsSystem r T) (hTne : T.Nonempty) {L : ℕ} (Y : Finset (Fin n) → Fin L → Ω → ℝ)
  (hmeas : ∀ (σ : Finset (Fin n)) (u : Fin L), Measurable (Y σ u))
  (hb : ∀ (σ : Finset (Fin n)) (u : Fin L) (ω : Ω), Y σ u ω ∈ Set.Icc 0 1)
  (hind : ∀ (σ : Finset (Fin n)), iIndepFun (Y σ) μ) (m : Finset (Fin n) → ℝ)
  (hmean : ∀ (σ : Finset (Fin n)) (u : Fin L), ∫ (x : Ω), Y σ u x ∂μ = m σ)
  (hmnn : ∀ (σ : Finset (Fin n)), 0 ≤ m σ) (hm1 : ∀ (σ : Finset (Fin n)), m σ ≤ 1)
  (hzero : ∀ (σ : Finset (Fin n)), m σ = 0 → ∀ (u : Fin L) (ω : Ω), Y σ u ω = 0) {a b c : ℝ}
  (ha0 : 0 ≤ a) (hac : a < c) (hcb : c < b) (htrue : ∀ σ ∈ T, b ≤ m σ)
  (hfalse : ∀ (τ : Finset (Fin n)), Splits.IsSide r τ → τ ∉ T → m τ ≤ a) :
  μ.real {ω | ¬RestrictedUnique r (fun σ ↦ ∑ u, Y σ u ω) (c * ↑L) T} ≤
    ∑ σ ∈ T, rexp (-(↑L * kl c (m σ))) + ∑ τ ∈ falseOcc r T m, rexp (-(↑L * kl c (m τ))) :=
  @Stemma.Chernoff.bedier_threshold Ω _ μ _ n r T hT hTne L Y hmeas hb hind m hmean hmnn hm1 hzero a b c ha0 hac hcb htrue hfalse

/-! ## Proposition 8.4: Largest-gap threshold (`prop:gap`) -/

open Stemma Stemma.GapThreshold MeasureTheory ProbabilityTheory Real Finset in
/-- Proposition 8.4 (Largest-gap threshold): `Stemma.GapThreshold.gap_separation`. -/
theorem «Report.8.4».gap_separation {ι : Type u_1} [DecidableEq ι] (T F : Finset ι) (m w : ι → ℝ)
  (a b g₂ : ℝ) (ha0 : 0 ≤ a) (hF : ∀ τ ∈ F, m τ ≤ a) (hbV : ∃ σ ∈ T, m σ = b)
  (hT : ∀ σ ∈ T, b ≤ m σ) (hg₂ : 0 ≤ g₂) (hG : g₂ < b - a)
  (hgaps : ∀ (x y : ℝ), IsGap (vals (T ∪ F) m) x y → (x, y) ≠ (a, b) → y - x ≤ g₂)
  (hdev : ∀ σ ∈ T ∪ F, |w σ - m σ| < (b - a - g₂) / 4) :
  (∃ x y, IsLargestGap (vals (T ∪ F) w) x y) ∧
    ∀ (x y : ℝ), IsLargestGap (vals (T ∪ F) w) x y → Separates T F w ((x + y) / 2) :=
  @Stemma.GapThreshold.gap_separation ι _ T F m w a b g₂ ha0 hF hbV hT hg₂ hG hgaps hdev

open Stemma Stemma.GapThreshold MeasureTheory ProbabilityTheory Real Finset in
/-- Proposition 8.4 (Largest-gap threshold): `Stemma.GapThreshold.gap_threshold`. -/
theorem «Report.8.4».gap_threshold {ι : Type u_1} [DecidableEq ι] {Ω : Type u_2}
  [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ] (T F : Finset ι) (m : ι → ℝ)
  (a b g₂ : ℝ) (ha0 : 0 ≤ a) (hF : ∀ τ ∈ F, m τ ≤ a) (hbV : ∃ σ ∈ T, m σ = b)
  (hT : ∀ σ ∈ T, b ≤ m σ) (hg₂ : 0 ≤ g₂) (hG : g₂ < b - a)
  (hgaps : ∀ (x y : ℝ), IsGap (vals (T ∪ F) m) x y → (x, y) ≠ (a, b) → y - x ≤ g₂) {L : ℕ}
  (hL : 0 < L) (Y : ι → Fin L → Ω → ℝ) (hmeas : ∀ (σ : ι) (u : Fin L), Measurable (Y σ u))
  (hb : ∀ (σ : ι) (u : Fin L) (ω : Ω), Y σ u ω ∈ Set.Icc 0 1)
  (hind : ∀ (σ : ι), iIndepFun (Y σ) μ)
  (hmean : ∀ (σ : ι) (u : Fin L), ∫ (x : Ω), Y σ u x ∂μ = m σ) :
  μ.real
      {ω |
        ¬((∃ x y, IsLargestGap (vals (T ∪ F) fun σ ↦ (∑ u, Y σ u ω) / ↑L) x y) ∧
            ∀ (x y : ℝ),
              IsLargestGap (vals (T ∪ F) fun σ ↦ (∑ u, Y σ u ω) / ↑L) x y →
                Separates T F (fun σ ↦ (∑ u, Y σ u ω) / ↑L) ((x + y) / 2))} ≤
    2 * (↑(#T) + ↑(#F)) * rexp (-↑L * (b - a - g₂) ^ 2 / 8) :=
  @Stemma.GapThreshold.gap_threshold ι _ Ω _ μ _ T F m a b g₂ ha0 hF hbV hT hg₂ hG hgaps L hL Y hmeas hb hind hmean

/-! ## Proposition 8.5: Rival test (`prop:rival`) -/

open Stemma Stemma.Rival Finset in
/-- Proposition 8.5 (Rival test): `Stemma.Rival.rival`. -/
theorem «Report.8.5».rival (p : Fin 3 → ℝ) (hs : p 0 + p 1 ≠ 0) (L k N : ℕ) :
  (prob p L fun x ↦ cnt 0 x = k ∧ cnt 0 x + cnt 1 x = N) =
    ↑(N.choose k) * (p 0 / (p 0 + p 1)) ^ k * (1 - p 0 / (p 0 + p 1)) ^ (N - k) * Hm p L N :=
  @Stemma.Rival.rival p hs L k N

/-! ## Theorem 8.7: Mechanisms of false support (`thm:mechanisms`) -/

open Stemma Stemma.Mechanisms Finset in
/-- Theorem 8.7 (Mechanisms of false support): `Stemma.Mechanisms.retention_coincidence_report`. -/
theorem «Report.8.7».retention_coincidence_report {n : ℕ} (att : Finset (Fin n) → Bool)
  {e f : Finset (Fin n)} (hd : Disjoint e f) (he : e.Nonempty) (hf : f.Nonempty) :
  (2 ≤ #(e ∪ f)ᶜ → PropU {e, f} att (e ∪ f)ᶜ ∧ SplitNT (e ∪ f)ᶜ) ∧
    (PropR {e, f} att (e ∪ f) ∧ ClusterNT (e ∪ f) ↔ att e = true ∧ att f = true ∧ e ∪ f ≠ univ) :=
  @Stemma.Mechanisms.retention_coincidence_report n att e f hd he hf

open Stemma Stemma.Mechanisms Finset in
/-- Theorem 8.7 (Mechanisms of false support): `Stemma.Mechanisms.overwrite_report`. -/
theorem «Report.8.7».overwrite_report {n : ℕ} (att : Finset (Fin n) → Bool)
  {e f : Finset (Fin n)} (hfe : f ⊂ e) (hf : f.Nonempty) (heU : e ≠ univ) (h2 : 2 ≤ #(e \ f)) :
  (PropU {e, f} att (e \ f) ∧ SplitNT (e \ f) ↔ ¬(att e = true ∧ att f = true)) ∧
    (PropR {e, f} att (e \ f) ∧ ClusterNT (e \ f) ↔ ¬(att e = true ∧ att f = true)) :=
  @Stemma.Mechanisms.overwrite_report n att e f hfe hf heU h2

/-! ## Corollary 8.8: Comparison of the codings (`cor:dominance`) -/

open Stemma Stemma.Dominance Finset Stemma.Mechanisms Stemma.Attraction in
/-- Corollary 8.8 (Comparison of the codings): `Stemma.Dominance.dominance`. -/
theorem «Report.8.8».dominance {n : ℕ} {K : Finset (Finset (Fin n))} {π : Finset (Fin n) → ℝ}
  {α : ℝ} (hπ0 : ∀ (e : Finset (Fin n)), 0 ≤ π e) (hπ1 : ∀ (e : Finset (Fin n)), π e ≤ 1)
  (hα0 : 0 ≤ α) (hα1 : α ≤ 1) (C : Finset (Fin n)) :
  ((ex K π α fun M att ↦ PR C M att ∧ #M ≤ 2) ≤ ex K π α fun M att ↦ PU C M att ∧ #M ≤ 2) ∧
    (ex K π α fun M att ↦ PR Cᶜ M att ∧ #M ≤ 2) ≤ ex K π α fun M att ↦ PU C M att ∧ #M ≤ 2 :=
  @Stemma.Dominance.dominance n K π α hπ0 hπ1 hα0 hα1 C

open Stemma Stemma.Dominance Finset Stemma.Mechanisms Stemma.Attraction in
/-- Corollary 8.8 (Comparison of the codings): `Stemma.Dominance.omega_dominance`. -/
theorem «Report.8.8».omega_dominance {n : ℕ} {α : ℝ} (hα0 : 0 ≤ α) (hα1 : α ≤ 1)
  (C : Finset (Fin n)) (S : Finset (Finset (Fin n))) :
  omega (PR C) α S ≤ omega (PU C) α S ∧ omega (PR Cᶜ) α S ≤ omega (PU C) α S :=
  @Stemma.Dominance.omega_dominance n α hα0 hα1 C S

