/-- `Stemma.Chernoff.RestrictedUnique`, as defined in the library. -/
theorem «Report.defs».Chernoff.RestrictedUnique_def {n : ℕ} (r : Fin n) (w : Finset (Fin n) → ℝ)
  (t : ℝ) (T : Finset (Finset (Fin n))) :
  RestrictedUnique r w t T =
    ((∀ σ ∈ T, t < w σ) ∧
      ∀ (S : Finset (Finset (Fin n))),
        Splits.IsSystem r S → (∀ τ ∈ S, t < w τ) → S ≠ T → Splits.wt w S < Splits.wt w T) := rfl

open Stemma Stemma.Chernoff MeasureTheory ProbabilityTheory Real Finset Filter
