  [IsProbabilityMeasure μ] (C R : ℕ → Ω → ℝ) (hC : ∀ (u : ℕ), Measurable (C u))
  (hR : ∀ (u : ℕ), Measurable (R u)) (hCi : Integrable (C 0) μ) (hRi : Integrable (R 0) μ)
  (hCind : Pairwise fun u v ↦ C u ⟂ᵢ[μ] C v) (hRind : Pairwise fun u v ↦ R u ⟂ᵢ[μ] R v)
  (hCid : ∀ (u : ℕ), IdentDistrib (C u) (C 0) μ μ)
  (hRid : ∀ (u : ℕ), IdentDistrib (R u) (R 0) μ μ) {c r : ℝ} (hc : ∫ (x : Ω), C 0 x ∂μ = c)
  (hr : ∫ (x : Ω), R 0 x ∂μ = r) (hrpos : 0 < r) :
  ∀ᵐ (ω : Ω) ∂μ,
    Tendsto (fun L ↦ (∑ u ∈ range L, C u ω) / ∑ u ∈ range L, R u ω) atTop (𝓝 (c / r)) :=
  @Stemma.Alpha.ratio_tendsto Ω _ μ _ C R hC hR hCi hRi hCind hRind hCid hRid c r hc hr hrpos

