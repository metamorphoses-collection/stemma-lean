/-- `Stemma.Chernoff.kl`, as defined in the library. -/
theorem «Report.defs».Chernoff.kl_def (c m : ℝ) :
  kl c m = c * log (c / m) + (1 - c) * log ((1 - c) / (1 - m)) := rfl

