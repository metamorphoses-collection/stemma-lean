/-! ## Theorem 9.4: Fixed-parameter tractability in n (`thm:fpt`) -/

open Stemma Stemma.Dynamic Finset Stemma.Splits in
open scoped Classical in
/-- Theorem 9.4 (Fixed-parameter tractability in n): `Stemma.Dynamic.dp_correct`. -/
theorem «Report.9.4».dp_correct {n : ℕ} (hn : 2 ≤ n) (x : Fin n) (w F P : Finset (Fin n) → ℕ)
  (hP0 : P ∅ = 0)
  (hF :
    ∀ (C : Finset (Fin n)) (hC : C.Nonempty),
      F C =
        (if IsSide x C then w C else 0) + (blocksF C (C.min' hC)).sup fun D ↦ F D + P (C \ D))
  (hP :
    ∀ (C : Finset (Fin n)) (hC : C.Nonempty),
      P C = (blocksP C (C.min' hC)).sup fun D ↦ F D + P (C \ D)) :
  (∀ (S : Finset (Finset (Fin n))), IsSystem x S → weight w S ≤ F (univ.erase x)) ∧
    ∃ S, IsSystem x S ∧ weight w S = F (univ.erase x) :=
  @Stemma.Dynamic.dp_correct n hn x w F P hP0 hF hP
