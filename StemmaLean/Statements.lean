/-- Theorem 7.14 (Consistency of the cutting-plane estimator): `Stemma.Cutting.cutting_consistent`. -/
theorem «Report.7.14».cutting_consistent {n : ℕ} {Ω : Type u_1} [MeasurableSpace Ω]
  {μ : Measure Ω} [IsProbabilityMeasure μ] [MeasurableSpace (Finset (PSplit n))]
  [MeasurableSingletonClass (Finset (PSplit n))] (r : Fin n) {T : Finset (Finset (Fin n))}
  (P : ℕ → Ω → Finset (PSplit n)) (hP : ∀ (u : ℕ), Measurable (P u))
  (hindep : Pairwise fun i j ↦ P i ⟂ᵢ[μ] P j) (hident : ∀ (u : ℕ), IdentDistrib (P u) (P 0) μ μ)
  {B : ℕ} (hB : ∀ (u : ℕ) (ω : Ω), #(P u ω) ≤ B)
  (hmax : ∀ (T' : Finset (Finset (Fin n))), IsBinary r T' → T' ≠ T → M μ P T' < M μ P T) :
  (∀ᵐ (ω : Ω) ∂μ,
      ∀ᶠ (L : ℕ) in atTop,
        ∀ (T' : Finset (Finset (Fin n))),
          IsBinary r T' →
            T' ≠ T →
              W P L T' ω < W P L T ω ∧
                ∃ u ∈ range L, ∃ s ∈ P u ω, Displays T s ∧ ¬Displays T' s) ∧
    Tendsto
      (fun L ↦
        μ
          {ω |
              ∀ (T' : Finset (Finset (Fin n))),
                IsBinary r T' → T' ≠ T → W P L T' ω < W P L T ω}ᶜ)
      atTop (𝓝 0) :=
  @Stemma.Cutting.cutting_consistent n Ω _ μ _ _ _ r T P hP hindep hident B hB hmax

