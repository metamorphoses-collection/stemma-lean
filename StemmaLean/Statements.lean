theorem «Report.defs».PairwiseCompat_def {n : ℕ} (S : Finset (Finset (Fin n))) :
  PairwiseCompat S = ∀ a ∈ S, ∀ b ∈ S, a ≠ b → Compat a b := rfl

open Stemma in
